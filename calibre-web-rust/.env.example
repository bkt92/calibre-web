# Database configuration
CALIBRE_WEB__DATABASE__URL=postgresql://user:password@localhost/calibre_web
CALIBRE_WEB__DATABASE__MAX_CONNECTIONS=10

# Server configuration
CALIBRE_WEB__SERVER__HOST=0.0.0.0
CALIBRE_WEB__SERVER__PORT=8083
CALIBRE_WEB__SERVER__WORKERS=4

# Library paths
CALIBRE_WEB__LIBRARY__LIBRARY_PATH=/var/lib/calibre-web/library
CALIBRE_WEB__LIBRARY__COVER_PATH=/var/lib/calibre-web/covers
CALIBRE_WEB__LIBRARY__UPLOAD_PATH=/var/lib/calibre-web/upload
